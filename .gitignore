# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
/cert.pem
*.pem
*.pptx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
daemon.log
*.log

# local verification artifacts
/.codex
/tmp-playwright-*.png
/.tmp/
/tmp/
/.claude/
/.venv/
dev-server.*.log
/papers/
/notebooks/
/scripts/__pycache__/

# python cache
__pycache__/
*.pyc
*.pyo

# colab experiment artifacts (duplicate model files)
/data/colab/

# locally collected data
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/tmp/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example

# local daemon/tunnel files
/.cloudflared/
/yeoksam-taxi.service
/cloudflared-yeoksam-taxi.service
/cloudflared-*.yml
/cloudflared-*.yaml

# generated report / presentation artifacts
/yeoksam-taxi*.zip
/docs/*결과보고서.pdf
/docs/산학협력_프로젝트_결과보고서.md
/docs/claude-pages-prompt.md
/docs/model-and-api-architecture.md
